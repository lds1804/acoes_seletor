<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Needed to scrape Fundamentus / SEC / Stooq. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- WorkManager periodically requires WAKE_LOCK on some OEMs. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".LynchScreenerApp"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LynchScreener"
        android:usesCleartextTraffic="true">
        <!--
            Note: usesCleartextTraffic=true is temporary while Stooq CSV (http)
            is an option. Consider a networkSecurityConfig before release.
            The launcher activity is added in Etapa 3 (Jetpack Compose screens).
        -->

        <!--
            Disable WorkManager's default on-demand initializer so we can supply
            our own Configuration (custom WorkerFactory with DI).
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
